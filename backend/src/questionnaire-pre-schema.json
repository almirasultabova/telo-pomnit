{
  "type": "object",
  "required": [
    "name",
    "age",
    "occupation",
    "familyStatus",
    "hasChildren",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "age": {
      "type": "string",
      "enum": [
        "до 25",
        "25–30",
        "31–35",
        "36–40",
        "41–45",
        "46–50",
        "старше 50"
      ]
    },
    "occupation": {
      "type": "string",
      "enum": [
        "найм (офис или удалённо)",
        "своё дело / самозанятость",
        "фриланс",
        "в декрете",
        "учусь",
        "не работаю сейчас",
        "другое"
      ]
    },
    "familyStatus": {
      "type": "string",
      "enum": [
        "в отношениях / замужем",
        "не в отношениях",
        "развожусь / недавно рассталась"
      ]
    },
    "hasChildren": {
      "type": "string",
      "enum": [
        "нет",
        "да, один ребёнок",
        "да, двое и больше"
      ]
    },
    "city": {
      "type": "string",
      "maxLength": 4000
    },
    "source": {
      "type": "string",
      "enum": [
        "от подруги или знакомой",
        "Telegram-канал",
        "Instagram",
        "сама нашла в поиске",
        "другое"
      ]
    },
    "referralName": {
      "type": "string",
      "maxLength": 4000
    },
    "whatCaughtAttention": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 7,
      "items": {
        "type": "string",
        "enum": [
          "тема работы с телом и реакциями",
          "соматический подход, не просто «осознайте»",
          "доверие к ведущим",
          "рекомендация подруги",
          "формат — живые встречи в группе",
          "цена",
          "другое"
        ]
      }
    },
    "priorExperience": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "индивидуальная терапия",
          "онлайн-курсы по психологии",
          "марафоны и групповые программы",
          "йога / дыхательные практики / медитация",
          "ничего, это первый опыт",
          "другое"
        ]
      }
    },
    "currentSituation": {
      "type": "string",
      "maxLength": 4000
    },
    "bodyTension": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "type": "string",
        "enum": [
          "горло / шея",
          "плечи / спина",
          "грудь / сердце",
          "живот",
          "челюсть",
          "голова",
          "чувствую онемение — тело как будто не моё",
          "не замечаю ничего конкретного"
        ]
      }
    },
    "bodyStressSensations": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 7,
      "items": {
        "type": "string",
        "enum": [
          "тяжесть",
          "зажатость, сдавленность",
          "дрожь или холод",
          "ком в горле или груди",
          "онемение, отключение",
          "жар, пульсация",
          "ничего не чувствую — уходит в голову"
        ]
      }
    },
    "stressReaction": {
      "type": "string",
      "enum": [
        "",
        "замираю — не могу думать или двигаться",
        "злюсь, спорю, защищаюсь",
        "ухожу — в работу, телефон, сон, еду",
        "начинаю подстраиваться, угождать, чтобы всё наладилось",
        "по-разному, зависит от ситуации"
      ]
    },
    "bodyContactScale": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "anxietyScale": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "hasTherapist": {
      "type": "string",
      "enum": [
        "",
        "да, работаю параллельно",
        "нет, но был раньше",
        "нет, никогда не было"
      ]
    },
    "successMeans": {
      "type": "string",
      "maxLength": 4000
    },
    "importantInWork": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "почувствовать, что я не одна с этим",
          "получить конкретные инструменты на каждый день",
          "наконец-то что-то почувствовать — а не только понять",
          "разобраться, почему тело реагирует именно так",
          "научиться останавливаться в моменте"
        ]
      }
    },
    "followedChannels": {
      "type": "string",
      "maxLength": 4000
    },
    "practiceTime": {
      "type": "string",
      "enum": [
        "",
        "5–10 минут",
        "10–20 минут",
        "20–30 минут",
        "больше 30 минут"
      ]
    },
    "futureInterest": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "да, хочу индивидуальные сессии",
          "да, интересен записанный курс",
          "да, хочу следующий поток в группе",
          "пока не знаю",
          "мне достаточно этой программы"
        ]
      }
    }
  }
}
